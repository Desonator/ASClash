#!/bin/sh

# Local Mihomo API client for LuCI diagnostics and configuration reload.
# Reads the API secret inside this helper and stores its curl config in a
# private tmpfs file, so the secret never appears in argv, output, or logs.

CONFIG_FILE="/opt/clash/config.yaml"

validate_encoded_segment() {
	[ -n "$1" ] || return 1
	printf '%s' "$1" | awk '
		BEGIN { hex = "0123456789abcdefABCDEF" }
		{
			if ($0 == "." || $0 == "..") exit 1
			for (i = 1; i <= length($0); i++) {
				c = substr($0, i, 1)
				if (c == "%") {
					if (i + 2 > length($0) || index(hex, substr($0, i + 1, 1)) == 0 || index(hex, substr($0, i + 2, 1)) == 0) exit 1
					byte = tolower(substr($0, i + 1, 2))
					if (byte == "00" || byte == "0a" || byte == "0d" || byte == "2e" || byte == "2f" || byte == "3f" || byte == "23" || byte == "25" || byte == "5c") exit 1
					i += 2
				} else if (c !~ /^[A-Za-z0-9._~-]$/) exit 1
			}
		}
	'
}

yaml_scalar() {
	scalar=$(awk -v wanted="$1" '
	function trim(value) {
		sub(/^[ \t]+/, "", value)
		sub(/[ \t\r]+$/, "", value)
		return value
	}
	function decode_quoted(value, quote, result, i, ch, escaped_char) {
		result = ""
		for (i = 2; i <= length(value); i++) {
			ch = substr(value, i, 1)
			if (quote == "\047" && ch == "\047" && substr(value, i + 1, 1) == "\047") {
				result = result "\047"
				i++
				continue
			}
			if (ch == quote) break
			if (quote == "\"" && ch == "\\") {
				escaped_char = substr(value, ++i, 1)
				if (escaped_char == "n") result = result "\n"
				else if (escaped_char == "r") result = result "\r"
				else if (escaped_char == "t") result = result "\t"
				else result = result escaped_char
			} else result = result ch
		}
		return result
	}
	/^[^ \t#][^:]*:/ {
		name = $0
		sub(/:.*/, "", name)
		if (name != wanted) next
		value = substr($0, index($0, ":") + 1)
		value = trim(value)
		first = substr(value, 1, 1)
		if (first == "\"" || first == "\047") {
			print decode_quoted(value, first)
			exit
		}
		sub(/[ \t]+#.*/, "", value)
		print trim(value)
		exit
	}
	' "$CONFIG_FILE" 2>/dev/null)
	if [ -n "$scalar" ]; then
		printf '%s\n' "$scalar"
		return 0
	fi

	# Keep a simple fallback for minimal BusyBox awk builds that reject one of
	# the YAML scalar escape forms above. The keys are fixed internal callers.
	line=$(grep -m1 -E "^[[:space:]]*$1[[:space:]]*:" "$CONFIG_FILE" 2>/dev/null) || return 0
	scalar=$(printf '%s\n' "$line" | sed -E "s/^[[:space:]]*$1[[:space:]]*:[[:space:]]*//; s/[[:space:]]+#.*$//; s/^['\"]//; s/['\"][[:space:]]*$//" | tr -d '\r')
	printf '%s\n' "$scalar"
}

case "${1:-}" in
	version) endpoint="version" ;;
	connections) endpoint="connections" ;;
	weights)
		[ "$#" -eq 2 ] && validate_encoded_segment "$2" || exit 7
		endpoint="group/$2/weights"
		;;
	conntrack)
		[ -r /proc/net/nf_conntrack ] || exit 6
		awk '/^ipv4 2 tcp / && (/ESTABLISHED/ || /SYN_SENT/ || /TIME_WAIT/) { print; n++; if (n >= 1024) exit }' /proc/net/nf_conntrack
		exit $?
		;;
	*) exit 2 ;;
esac

[ -r "$CONFIG_FILE" ] || exit 1

controller=$(yaml_scalar external-controller)
tls_controller=$(yaml_scalar external-controller-tls)
secret=$(yaml_scalar secret)

if [ -n "$tls_controller" ]; then
	protocol="https"
	address="$tls_controller"
else
	protocol="http"
	address="$controller"
fi
[ -n "$address" ] || exit 3

case "$address" in
	http://*) protocol="http"; address=${address#http://} ;;
	https://*) protocol="https"; address=${address#https://} ;;
esac

case "$address" in
	0.0.0.0:*) address="127.0.0.1:${address#*:}" ;;
	\[::\]:*) address="[::1]:${address#*]:}" ;;
	:*) address="127.0.0.1$address" ;;
esac

case "$protocol://$address" in
	http://127.0.0.1:*|https://127.0.0.1:*|http://localhost:*|https://localhost:*|http://\[::1\]:*|https://\[::1\]:*) ;;
	*) exit 4 ;;
esac

umask 077
auth_config=$(mktemp /tmp/asclash-api.XXXXXX) || exit 1
trap 'rm -f "$auth_config"' 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if [ -n "$secret" ]; then
	newline=$(printf '\nX')
	newline=${newline%X}
	carriage_return=$(printf '\r')
	case "$secret" in
		*"$newline"*|*"$carriage_return"*) exit 5 ;;
	esac
	# Escape curl-config quoted-string syntax; keep the token only in this
	# mode-600 file on tmpfs, never on the command line.
	escaped_secret=$(printf '%s' "$secret" | sed 's/\\/\\\\/g; s/"/\\"/g') || exit 1
	printf 'header = "Authorization: Bearer %s"\n' "$escaped_secret" > "$auth_config" || exit 1
fi

max_time=4
[ "$endpoint" = "connections" ] && max_time=2
case "$endpoint" in
	*/*/weights) max_time=6 ;;
esac
tls_option=""
[ "$protocol" = "https" ] && tls_option="-k"
curl --silent --show-error --noproxy '*' --connect-timeout 2 --max-time "$max_time" \
	$tls_option --config "$auth_config" --write-out '\n%{http_code}' \
	"$protocol://$address/$endpoint"
curl_status=$?
[ "$curl_status" -eq 0 ] || exit 10
