#!/bin/sh
# Part of the ASClash package — installed to /etc/hotplug.d/net/99-clash-tun
#
# Reacts to clash-tun creation/removal. On add it immediately installs the
# TUN route; on remove it restores fail-closed routes so marks cannot fall
# through to the main table while the core recreates its tunnel.

[ -x /opt/clash/bin/clash-rules ] || exit 0

case "$ACTION" in
    add)
        [ "$INTERFACE" = "clash-tun" ] || exit 0
        /opt/clash/bin/clash-rules tun_route_setup
        /opt/clash/bin/clash-rules repair_policy
        ;;
    remove)
        [ "$INTERFACE" = "clash-tun" ] || exit 0
        /opt/clash/bin/clash-rules tun_route_fallback
        ;;
esac
