### Модуль config.js — Reload config / Restart core ###

msgid "Reload configuration via Mihomo API — active connections are preserved. Firewall rules are NOT rebuilt; use \"Save & Restart core\" when changing external-controller / tproxy-port / tun / fake-ip-filter-mode / proxy mode."
msgstr "Перезагрузка конфигурации через API Mihomo — активные соединения сохраняются. Правила файрвола НЕ перестраиваются; используйте «Сохранить и перезапустить ядро» при изменении external-controller / tproxy-port / tun / fake-ip-filter-mode / режима проксирования."

msgid "Full restart: stops and starts the Mihomo core, rebuilds firewall rules and refreshes subscription IPs. Active connections are dropped."
msgstr "Полный перезапуск: останавливает и запускает ядро Mihomo, перестраивает правила файрвола и обновляет IP подписок. Активные соединения будут разорваны."

msgid "Service is not running — config reload requires a running Mihomo instance. Use \"Save & Restart core\" instead."
msgstr "Служба не запущена — для перезагрузки конфига нужен работающий Mihomo. Используйте «Сохранить и перезапустить ядро»."

msgid "Config reload failed (%s, HTTP %s). %s Try \"Save & Restart core\" for a full restart."
msgstr "Перезагрузка конфига не удалась (%s, HTTP %s). %s Попробуйте «Сохранить и перезапустить ядро» для полного перезапуска."

msgid "(Hint: the system curl has no HTTPS support. Install curl-ssl, or use plain external-controller for hot reload.)"
msgstr "(Подсказка: системный curl не поддерживает HTTPS. Установите пакет curl-ssl или используйте обычный external-controller для перезагрузки конфига.)"

msgid "Config reloaded, but updating subscription IP cache failed: %s"
msgstr "Конфиг перезагружен, но обновление кеша IP подписок не удалось: %s"

msgid "Config reloaded via Mihomo API — active connections preserved."
msgstr "Конфиг перезагружен через API Mihomo — активные соединения сохранены."

msgid "Config reload error: %s. Try \"Save & Restart core\" for a full restart."
msgstr "Ошибка перезагрузки конфига: %s. Попробуйте «Сохранить и перезапустить ядро» для полного перезапуска."

